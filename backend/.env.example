# Copie para .env somente se ainda não existir; nunca versione credenciais reais.
# Senha na URI deve ser percent-encoded (espaço: %20; @: %40; #: %23).
DATABASE_URL=postgresql://postgres:<SENHA_DO_SUPABASE>@db.vcpharygvnbihxmtdsll.supabase.co:5432/postgres?sslmode=require
# Rede sem IPv6: copie o Session Pooler EXATO em Supabase > Connect.
# DATABASE_URL=postgresql://postgres.vcpharygvnbihxmtdsll:<SENHA>@<HOST_DO_SESSION_POOLER>:5432/postgres?sslmode=require
# Desenvolvimento isolado, sem acesso remoto:
# DATABASE_URL=sqlite:///./industrack.db
JWT_SECRET_KEY=
ENVIRONMENT=development
MODO_DEMO=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Render: ENVIRONMENT=production, JWT_SECRET_KEY aleatório com 32+ caracteres,
# FRONTEND_URL e CORS_ORIGINS com a origem HTTPS exata da Vercel.
# Demo hospedada isolada: ENVIRONMENT=demo e MODO_DEMO=true, somente dados fictícios.
