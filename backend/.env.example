# Desenvolvimento local (o banco existente é preservado)
DATABASE_URL=sqlite:///./industrack.db
# Opcional em desenvolvimento; um segredo temporário é gerado se estiver vazio/curto.
# Em produção, configure JWT_SECRET_KEY com pelo menos 32 caracteres.
JWT_SECRET_KEY=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# QR exige HTTPS público; use o domínio real antes de emitir etiquetas.
FRONTEND_URL=http://localhost:5173
# Vercel: SQLite temporário, apenas para demonstração; os dados podem sumir.
# DATABASE_URL=sqlite:////tmp/industrack.db
# ALLOW_EPHEMERAL_SQLITE=true
# ENVIRONMENT=production
# JWT_SECRET_KEY=gere-um-segredo-aleatorio-com-mais-de-32-caracteres
# FRONTEND_URL=https://SEU-PROJETO.vercel.app
# CORS_ORIGINS=https://SEU-PROJETO.vercel.app
